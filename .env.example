# Public app URL used in client-generated links
NEXT_PUBLIC_APP_URL=http://localhost:3333

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SMTP config for invitation and email flows
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=HRM <no-reply@example.com>
APP_BASE_URL=http://localhost:3333

# Optional client-side debug controls
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=warn
