+export type ContractPlaceholderStatus =
+  | 'hop_le'
+  | 'thieu_du_lieu'
+  | 'field_la'
+  | 'trung_lap'
+
+export type ContractPlaceholderItem = {
+  key: string
+  group: ContractPlaceholderGroup | 'unknown'
+  field: string
+  occurrences: number
+  value: string
+  status: ContractPlaceholderStatus
+  note?: string
+}
+
+export const CONTRACT_PLACEHOLDER_CATALOG = {
+  employee: [
+    'full_name',
+    'employee_code',
+    'phone',
+    'email',
+    'address',
+    'date_of_birth',
+    'gender',
+    'cccd',
+    'cccd_issue_date',
+    'cccd_issue_place',
+    'tax_code',
+    'bank_name',
+    'bank_account',
+    'start_date',
+  ],
+  store: ['name', 'address', 'phone', 'manager_name'],
+  position: ['name', 'level'],
+  contract: [
+    'id',
+    'code',
+    'version',
+    'parent_contract_code',
+    'type',
+    'type_label',
+    'start_date',
+    'end_date',
+    'signing_date',
+    'signer_name',
+    'signer_title',
+  ],
+  salary: [
+    'official',
+    'probation',
+    'allowances',
+    'kpi',
+    'probation_period',
+    'payday',
+    'hourly_or_shift',
+  ],
+  policy: [
+    'work_rules',
+    'dress_code',
+    'cash_handling',
+    'food_safety',
+    'attendance',
+    'overtime',
+    'discipline',
+    'contract_note',
+  ],
+  company: ['name', 'address', 'tax_id', 'signer_name', 'signer_title'],
+  job: ['main_duties', 'working_schedule'],
+} as const
+
+const PLACEHOLDER_REGEX = /{{\s*([a-z0-9_]+)\.([a-z0-9_]+)\s*}}/g
+
+function isKnownGroup(group: string): group is ContractPlaceholderGroup {
+  return group in CONTRACT_PLACEHOLDER_CATALOG
+}
+
+export function scanContractPlaceholders(
+  sourceText: string,
+  values: Record<string, string> = {},
+): ContractPlaceholderItem[] {
+  const counts = new Map<string, number>()
+
+  for (const match of sourceText.matchAll(PLACEHOLDER_REGEX)) {
+    const key = `${match[1]}.${match[2]}`
+    counts.set(key, (counts.get(key) || 0) + 1)
+  }
+
+  return Array.from(counts.entries()).map(([key, occurrences]) => {
+    const [groupRaw, field] = key.split('.')
+    const group = isKnownGroup(groupRaw) ? groupRaw : 'unknown'
+    const allowed = group !== 'unknown' && CONTRACT_PLACEHOLDER_CATALOG[group].includes(field as never)
+    const value = String(values[key] || '').trim()
+
+    if (!allowed) {
+      return {
+        key,
+        group,
+        field,
+        occurrences,
+        value,
+        status: 'field_la',
+        note: 'Field khong nam trong bo chuan',
+      }
+    }
+
+    if (!value) {
+      return {
+        key,
+        group,
+        field,
+        occurrences,
+        value,
+        status: 'thieu_du_lieu',
+        note: 'Chua co gia tri de do vao hop dong',
+      }
+    }
+
+    if (occurrences > 1) {
+      return {
+        key,
+        group,
+        field,
+        occurrences,
+        value,
+        status: 'trung_lap',
+        note: 'Field xuat hien nhieu lan trong mau',
+      }
+    }
+
+    return {
+      key,
+      group,
+      field,
+      occurrences,
+      value,
+      status: 'hop_le',
+    }
+  })
+}
