{
  "manifest_version": 3,
  "name": "Homies iPOS Bridge - Tự Động Đồng Bộ HRM",
  "version": "1.0.0",
  "description": "Tiện ích tự động bắt và đồng bộ dữ liệu chấm công, bảng lương, nhân sự từ iPOS HRM sang Homies HRM.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Homies iPOS Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.ipos.vn/*",
    "*://*.fabi.vn/*",
    "*://localhost/*",
    "http://localhost:3535/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ipos.vn/*",
        "*://*.fabi.vn/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected-hook.js"],
      "matches": [
        "*://*.ipos.vn/*",
        "*://*.fabi.vn/*"
      ]
    }
  ]
}
